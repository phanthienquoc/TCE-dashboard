{
  "name": "service",
  "projectType": "application",
  "sourceRoot": "apps/service/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./node_modules/.bin/tsc -p apps/service/tsconfig.json && node apps/service/scripts/fix-esm-extensions.mjs dist/apps/service"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/service"
      }
    }
  }
}
