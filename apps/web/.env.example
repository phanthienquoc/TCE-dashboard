NEXT_PUBLIC_AUTH_BASE_URL=https://auth.mrcute.space
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=wss://ws.mrcute.space/ws

# SSO fallback defaults: legacy auth remains active unless explicitly enabled by deployment.
# These public OIDC endpoints/client identifiers are not secrets.
NEXT_PUBLIC_AUTH_MODE=legacy
NEXT_PUBLIC_KEYCLOAK_URL=https://sso.mrcute.space
NEXT_PUBLIC_KEYCLOAK_REALM=mrcute
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tce-dashboard
