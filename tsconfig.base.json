{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tce/platform": ["libs/platform/src/index.ts"],
      "@tce/shared": ["libs/shared/src/index.ts"],
      "@tce/auth": ["libs/auth/src/index.ts"],
      "@tce/db": ["libs/db/src/index.ts"],
      "@tce/tce": ["libs/tce/src/index.ts"],
      "@tce/ssi": ["libs/ssi/src/index.ts"],
      "@tce/binance": ["libs/binance/src/index.ts"],
      "@tce/fastapi": ["libs/fastapi/src/index.ts"],
      "@tce/dashboard-data": ["libs/dashboard-data/src/index.ts"]
    }
  }
}
