{
  "name": "tce-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nx serve web",
    "build": "nx run-many -t build --projects=web,service",
    "test": "tsx --tsconfig tsconfig.base.json --test $(find libs/binance/src libs/ssi/src libs/tce/src apps/service/src/platform -type f -name '*.spec.ts' ! -name 'assisted-approval.spec.ts' ! -name 'hunting-dividend.engine.spec.ts' ! -name 'trading-authorization.spec.ts') && npx --yes vitest@5.0.0 run --globals libs/tce/src/execution/assisted-approval.spec.ts libs/tce/src/decision/hunting-dividend.engine.spec.ts libs/tce/src/execution/trading-authorization.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:nx": "nx run-many -t lint",
    "lint:nx:fix": "nx run-many -t lint:fix",
    "typecheck": "tsc -p apps/service/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "build:web": "next build apps/web",
    "build:nx:web": "nx build web",
    "build:service": "nx build service",
    "serve:web": "nx serve web",
    "serve:service": "nx serve service",
    "start:web": "next start apps/web -p 80",
    "analyze:web": "ANALYZE=true next build apps/web"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@ssi.developer/ssi-sdk": "3.2.1",
    "@supabase/supabase-js": "^2.105.0",
    "@types/node": "^24.3.0",
    "axios": "^1.11.0",
    "binance": "^3.6.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "web-push": "3.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/web-push": "3.6.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "nx": "^21.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
